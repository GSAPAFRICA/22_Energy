{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "22energy",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "QUOTE_EMAIL_TO": "22energyorg@gmail.com",
    "TURNSTILE_ALLOWED_HOSTNAMES": "22energy.org,www.22energy.org"
  },
  "send_email": [
    {
      "name": "QUOTE_EMAIL",
      "destination_address": "22energyorg@gmail.com",
      "allowed_sender_addresses": [
        "marketing@22energy.org"
      ]
    }
  ]
}
